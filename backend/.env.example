# Hermes Trading System — Environment Variables
# Copy to .env and fill in values

# Database (PostgreSQL 15)
DATABASE_URL=postgresql+asyncpg://trading_user:your_secure_password@localhost:5432/trading_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=generate-a-32-character-random-string-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Binance Exchange (CCXT)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Claude AI (for strategy generation + optimization)
CLAUDE_API_KEY=sk-ant-...

# Anthropic/MiniMax LLM (Anthropic-compatible API)
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_API_KEY=your_token_plan_key_here

# App
APP_NAME=Hermes Trading System
DEBUG=false